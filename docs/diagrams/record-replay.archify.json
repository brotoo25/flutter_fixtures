  "cards": [
    {
      "dot": "cyan",
      "title": "Adapters",
      "items": [
        "RecorderInterceptor tags replays and re-raises error statuses",
        "RecorderDatabaseAdapter wraps any DatabaseAdapter",
        "Both call decide/record with lazy builders: idle traffic is free"
      ]
    },
    {
      "dot": "violet",
      "title": "Core seam",
      "items": [
        "TrafficRecorder is two calls, no mode inspection",
        "Sealed ReplayDecision: Replayed / ForwardToSource / RejectRequest",
        "Request identity: canonicalTarget (HTTP), recordingTarget (sqflite)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Engine",
      "items": [
        "FixtureRecorder notifies on mode change, capture, replayed hit, and after save",
        "SessionReplay serves each recording once; progress is observable",
        "Stores: FileRecordingSessionStore, MemoryRecordingSessionStore"
      ]
    }
  ]
